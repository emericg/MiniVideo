#ifndef MINIVIDEO_SETTINGS_H
#define MINIVIDEO_SETTINGS_H
/* ************************************************************************** */

// "minivideo_settings.h.in" is the template file, it is found in the SOURCE directory

// "minivideo_settings.h" is GENERATED by CMake from the template file, it is found in the BUILD directory

#define minivideo_VERSION_MAJOR @minivideo_VERSION_MAJOR@
#define minivideo_VERSION_MINOR @minivideo_VERSION_MINOR@
#define minivideo_VERSION_PATCH @minivideo_VERSION_PATCH@

#cmakedefine01 ENABLE_DEBUG
#cmakedefine01 ENABLE_COLORS

#cmakedefine01 ENABLE_STB_IMAGE_WRITE
#cmakedefine01 ENABLE_AVIF
#cmakedefine01 ENABLE_WEBP
#cmakedefine01 ENABLE_JPEG
#cmakedefine01 ENABLE_PNG

#cmakedefine01 ENABLE_MEMFD

/* ************************************************************************** */
#endif // MINIVIDEO_SETTINGS_H
